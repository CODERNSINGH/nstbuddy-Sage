PORT=4000
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=change-me

# Public URL of the web app (used in share links + emails)
WEB_URL=http://localhost:5173

# ---- EMAIL (student password mails) ----
# Render FREE instances block SMTP ports 25/465/587. On Render either use a paid instance,
# an SMTP provider on port 2525 (e.g. Brevo), or set RESEND_API_KEY (HTTPS, always works).
RESEND_API_KEY=
# Leave SMTP_HOST empty = emails are only printed in this terminal.
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=yourname@gmail.com
#   SMTP_PASS=<16 letter App Password>   (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NstBuddy Sage <yourname@gmail.com>"


# ---- OPTIONAL ----
# Where the Mac installer is fetched from (default: latest GitHub Release of this repo).
# DOWNLOAD_SOURCE_URL=
# Render sets RENDER_EXTERNAL_URL itself and the backend pings it every 14 minutes so the free plan does not sleep.
# KEEP_ALIVE_URL=
# KEEP_ALIVE_MINUTES=14
