PORT=4000
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=change-me

# Public URL of the web app (used in share links + emails)
WEB_URL=http://localhost:5173

# ---- EMAIL (student password mails) ----
# Leave SMTP_HOST empty = emails are only printed in this terminal.
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=yourname@gmail.com
#   SMTP_PASS=<16 letter App Password>   (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NstBuddy Sage <yourname@gmail.com>"
